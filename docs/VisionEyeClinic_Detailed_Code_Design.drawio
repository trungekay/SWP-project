        <mxCell id="44" value="Class diagrams show selected implemented members and dependencies. Servlet classes extend HttpServlet. Sequence diagrams show calls, dashed returns, lifelines and execution bars. Some trivial return messages are omitted. Notes identify conditions and alternative branches." style="text;html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#111111;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=4;fontSize=15;fontStyle=0;align=left;" vertex="1" parent="1">
          <mxGeometry x="52" y="1055" width="1550" height="85" as="geometry" />
        </mxCell>
        <mxCell id="45" value="Coverage boundary" style="text;html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#111111;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=4;fontSize=18;fontStyle=1;align=left;" vertex="1" parent="1">
          <mxGeometry x="52" y="1150" width="1500" height="36" as="geometry" />
        </mxCell>
        <mxCell id="46" value="The main implemented workflows are covered; supporting CRUD and public website content are summarized, not expanded into one sequence per endpoint. Procedure referral creation is not shown as complete because no caller of createProcedureOrder() was found. Eyeglass_Prescription is referenced by code but absent from the base SQL; Refund_Request_Item is initialized by RefundWorkflowSchema." style="text;html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#111111;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=4;fontSize=15;fontStyle=0;align=left;" vertex="1" parent="1">
          <mxGeometry x="52" y="1195" width="1550" height="135" as="geometry" />
        </mxCell>
        <mxCell id="47" value="Sources: src/java/com/visioncare; web; database/eye_clinic_db.sql; database/doctor_schedule_change.sql. Layout references: sample SDS and Template2_SDS." style="text;html=0;whiteSpace=wrap;overflow=hidden;fontFamily=Arial;fontSize=14;fontColor=#111111;fillColor=none;strokeColor=none;align=left;verticalAlign=middle;spacing=4;fontSize=11;fontStyle=0;align=left;" vertex="1" parent="1">
          <mxGeometry x="44" y="1375" width="1592" height="45" as="geometry" />
        </mxCell>
