        <mxCell id="83" value="Pending → Approved/Rejected → Completed. Director approval does not record a payout; revenue is affected only after staff confirmation. Refund_Request_Item is created at startup by RefundWorkflowSchema.ensure and is absent from the base SQL script." style="rounded=0;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#111111;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
