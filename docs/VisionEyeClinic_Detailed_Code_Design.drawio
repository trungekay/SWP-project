        <mxCell id="65" value="Rescheduling is allowed only for Confirmed appointments with a deposit, before check-in, refund, or invoice finalization. The DAO locks the patient, appointment, and both slots; email is sent after COMMIT, and email failure does not undo the reschedule." style="rounded=0;html=0;whiteSpace=wrap;fontFamily=Arial;fontSize=14;fontColor=#111111;fillColor=#FFFFFF;strokeColor=#333333;strokeWidth=1;align=left;spacing=12;fontSize=13;" vertex="1" parent="1">
