<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
                             http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>VisionCare — Eye Clinic Booking</display-name>

    <!-- ========== Welcome File ========== -->
    <welcome-file-list>
        <welcome-file>home</welcome-file>
    </welcome-file-list>

    <!-- ========== Error Pages ========== -->
    <error-page>
        <error-code>404</error-code>
        <location>/views/error/404.jsp</location>
    </error-page>

    <error-page>
        <error-code>403</error-code>
        <location>/views/error/403.jsp</location>
    </error-page>

    <error-page>
        <error-code>500</error-code>
        <location>/views/error/500.jsp</location>
    </error-page>
    <!-- Specialist Patient Detail (Screen 35) -->
    <servlet>
        <servlet-name>SpecialistPatientDetailServlet</servlet-name>
        <servlet-class>com.visioncare.controller.SpecialistPatientDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SpecialistPatientDetailServlet</servlet-name>
        <url-pattern>/specialist/patient-detail</url-pattern>
    </servlet-mapping>

    <!-- Specialist Procedure Detail (Screen 36) -->
    <servlet>
        <servlet-name>SpecialistProcedureDetailServlet</servlet-name>
        <servlet-class>com.visioncare.controller.SpecialistProcedureDetailServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SpecialistProcedureDetailServlet</servlet-name>
        <url-pattern>/specialist/procedure-detail</url-pattern>
    </servlet-mapping>

    <!-- Staff Refund Request Screen -->
    <servlet>
        <servlet-name>StaffRefundServlet</servlet-name>
        <servlet-class>com.visioncare.controller.StaffRefundServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>StaffRefundServlet</servlet-name>
        <url-pattern>/staff/refund-request</url-pattern>
    </servlet-mapping>
    <servlet-mapping>
        <servlet-name>StaffRefundServlet</servlet-name>
        <url-pattern>/staff/refunds</url-pattern>
    </servlet-mapping>

</web-app>
