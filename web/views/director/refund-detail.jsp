<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<fmt:setLocale value="vi_VN" />
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Chi tiết yêu cầu <c:out value="${refund.formattedId}" /> - VisionCare</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/employee.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/director-refunds.css?v=20261030-2" rel="stylesheet"></head><body>
<jsp:include page="/views/director/layout/director-sidebar.jsp"><jsp:param name="activeNav" value="refunds" /></jsp:include><main class="main-wrapper"><jsp:include page="/views/employee/layout/employee-header.jsp" /><div class="page-content refund-page">
<a class="refund-back" href="${pageContext.request.contextPath}/director/refunds"><i class="bi bi-arrow-left me-1"></i>Danh sách yêu cầu hoàn tiền</a>
<div class="refund-heading"><div><h2>Chi tiết yêu cầu <c:out value="${refund.formattedId}" /></h2><span class="badge ${refund.badgeClass}"><c:out value="${refund.statusVn}" /></span></div><div class="refund-amount"><fmt:formatNumber value="${refund.amount}" /> đ</div></div>
<c:if test="${not empty successMessage}"><div class="alert alert-success"><c:out value="${successMessage}" /></div></c:if><c:if test="${not empty errorMessage}"><div class="alert alert-danger"><c:out value="${errorMessage}" /></div></c:if>
<section class="refund-card"><h5>Thông tin đối chiếu</h5><dl class="refund-facts"><div><dt>Bệnh nhân</dt><dd><strong><c:out value="${refund.patientName}" /></strong> · <c:out value="${refund.patientPhone}" /></dd></div><div><dt>Email nhận thông báo</dt><dd class="refund-email"><c:out value="${refund.patientEmail}" default="Chưa cập nhật email" /></dd></div><div><dt>Hóa đơn / Lịch hẹn</dt><dd><a href="${pageContext.request.contextPath}/staff/invoices/detail?id=${refund.invoiceId}"><c:out value="${refund.formattedInvoiceId}" /></a> · <c:out value="${refund.formattedApptId}" /></dd></div><div><dt>Loại yêu cầu</dt><dd>${refund.kind == 'Items' ? 'Hoàn thuốc / thủ thuật chưa sử dụng' : 'Hoàn phí khám khi hủy lịch trước check-in'}</dd></div><div><dt>Người tạo</dt><dd><c:out value="${refund.creatorName}" /> · <c:out value="${refund.createdAt}" /></dd></div><div><dt>Người duyệt / quyết định</dt><dd><c:out value="${refund.approverName}" /></dd></div><div><dt>Trạng thái lịch hẹn</dt><dd><c:choose><c:when test="${refund.appointmentStatus == 'Canceled'}">Đã hủy</c:when><c:when test="${refund.appointmentStatus == 'Completed'}">Khám xong</c:when><c:when test="${refund.appointmentStatus == 'In_Progress'}">Đang khám</c:when><c:otherwise>Chờ tiếp đón / Xác nhận</c:otherwise></c:choose></dd></div><div><dt>Tiếp đón</dt><dd>${empty refund.checkin ? 'Chưa check-in' : 'Đã check-in'}</dd></div></dl><hr><h6>Lý do yêu cầu</h6><p class="mb-0" style="white-space:pre-wrap"><c:out value="${refund.reason}" /></p>
<c:if test="${not empty refund.lines}"><div class="table-responsive mt-3"><table class="table"><thead><tr><th>Khoản hoàn</th><th>Số lượng</th><th>Đơn giá đã thu</th><th>Thành tiền</th></tr></thead><tbody><c:forEach var="line" items="${refund.lines}"><tr><td><c:out value="${line.name}" /></td><td>${line.quantity}</td><td><fmt:formatNumber value="${line.unitPrice}" /> đ</td><td><fmt:formatNumber value="${line.amount}" /> đ</td></tr></c:forEach></tbody></table></div></c:if>
<c:if test="${not empty refund.decisionNote}"><div class="alert alert-light border mt-3 mb-0"><strong>Ý kiến director:</strong> <c:out value="${refund.decisionNote}" /></div></c:if></section>
<c:choose><c:when test="${refund.status == 'Pending'}"><section class="refund-card"><h5>Quyết định của director</h5><p class="refund-muted">Duyệt yêu cầu gửi email thông báo hoàn trong vòng 1 tuần. Staff thực hiện chi trả bên ngoài và xác nhận sau; duyệt chưa làm giảm doanh thu.</p><div class="refund-forms">
<form method="post" action="${pageContext.request.contextPath}/director/refunds"><input type="hidden" name="csrfToken" value="${sessionScope.workflowCsrf}"><input type="hidden" name="refundId" value="${refund.id}"><input type="hidden" name="returnToDetail" value="yes"><h6 class="text-success">Đồng ý hoàn tiền</h6><label for="approvalNote" class="form-label">Ghi chú duyệt (không bắt buộc)</label><textarea id="approvalNote" name="approvalNote" class="form-control mb-3" maxlength="1000"></textarea><button name="action" value="approve" class="btn btn-success"><i class="bi bi-check-circle me-1"></i>Duyệt hoàn tiền</button></form>
<form method="post" action="${pageContext.request.contextPath}/director/refunds"><input type="hidden" name="csrfToken" value="${sessionScope.workflowCsrf}"><input type="hidden" name="refundId" value="${refund.id}"><input type="hidden" name="returnToDetail" value="yes"><h6 class="text-danger">Không đồng ý hoàn tiền</h6><label for="rejectNote" class="form-label">Lý do từ chối <span class="text-danger">*</span></label><textarea id="rejectNote" name="rejectNote" class="form-control mb-3" required maxlength="1000"></textarea><button name="action" value="reject" class="btn btn-outline-danger"><i class="bi bi-x-circle me-1"></i>Từ chối hoàn tiền</button></form>
</div></section></c:when><c:otherwise><div class="alert alert-info">Yêu cầu đã có quyết định: <strong><c:out value="${refund.statusVn}" /></strong>. <c:if test="${refund.status == 'Approved'}">Staff xác nhận chi trả tại trang chi tiết hóa đơn.</c:if></div></c:otherwise></c:choose>
<section class="refund-card" id="refund-email-status"><h5>Email thông báo cho bệnh nhân</h5><p>Địa chỉ nhận: <strong class="refund-email"><c:out value="${refund.patientEmail}" default="Chưa cập nhật email" /></strong></p><p>Trạng thái: <strong><c:out value="${refund.notificationLabel}" /></strong></p><c:if test="${refund.status == 'Pending'}"><p class="small refund-muted mb-0">Yêu cầu đang chờ duyệt nên chưa phát sinh email quyết định. Sau khi duyệt hoặc từ chối, hệ thống tự gửi và cập nhật trạng thái ở đây.</p></c:if><c:if test="${refund.notificationStatus == 'Sent'}"><p class="small refund-muted mb-0">Thư đã được máy chủ gửi email chấp nhận lúc <fmt:formatDate value="${refund.notificationSentAt}" pattern="dd/MM/yyyy HH:mm:ss" />. Người nhận cần kiểm tra Hộp thư đến / Thư rác; trạng thái này không xác nhận bệnh nhân đã đọc thư.</p></c:if><c:if test="${refund.notificationStatus == 'Pending' || refund.notificationStatus == 'Sending'}"><p class="small refund-muted">Hệ thống gửi tự động và thử lại khi gặp lỗi. Tải lại trang để xem kết quả.</p></c:if><c:if test="${refund.notificationStatus == 'Failed'}"><p class="text-danger">Gửi không thành công sau ${refund.notificationAttempts} lần. Kiểm tra địa chỉ nhận và cấu hình email trước khi gửi lại.</p><form method="post" action="${pageContext.request.contextPath}/director/refunds"><input type="hidden" name="csrfToken" value="${sessionScope.workflowCsrf}"><input type="hidden" name="refundId" value="${refund.id}"><input type="hidden" name="returnToDetail" value="yes"><button class="btn btn-outline-primary" name="action" value="retry-email">Gửi lại email thông báo</button></form></c:if>
</section></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script></body></html>
