<%@page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<fmt:setLocale value="vi_VN" />
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Duyệt yêu cầu hoàn tiền - VisionCare</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/employee.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/director-refunds.css?v=20261030-2" rel="stylesheet"></head><body>
<jsp:include page="/views/director/layout/director-sidebar.jsp"><jsp:param name="activeNav" value="refunds" /></jsp:include>
<main class="main-wrapper"><jsp:include page="/views/employee/layout/employee-header.jsp" /><div class="page-content refund-page">
<div class="refund-heading"><div><h2>Duyệt yêu cầu hoàn tiền</h2><p class="refund-muted mb-0">Mở chi tiết để kiểm tra khoản hoàn, duyệt hoặc từ chối và theo dõi email thông báo.</p></div></div>
<c:if test="${not empty successMessage}"><div class="alert alert-success"><c:out value="${successMessage}" /></div></c:if><c:if test="${not empty errorMessage}"><div class="alert alert-danger"><c:out value="${errorMessage}" /></div></c:if>
<div class="refund-stats"><div class="refund-card">Tổng yêu cầu<strong>${stats.total}</strong></div><div class="refund-card">Chờ director duyệt<strong class="text-warning">${stats.pending}</strong></div><div class="refund-card">Đã duyệt · Chờ staff chi trả<strong class="text-primary">${stats.approved}</strong></div><div class="refund-card">Đã hoàn tiền<strong class="text-success">${stats.completed}</strong></div></div>
<div class="refund-card refund-filters"><a href="${pageContext.request.contextPath}/director/refunds?status=all" class="${currentStatus == 'all' ? 'active' : ''}">Tất cả (${stats.total})</a><a href="${pageContext.request.contextPath}/director/refunds?status=Pending" class="${currentStatus == 'Pending' ? 'active' : ''}">Chờ duyệt (${stats.pending})</a><a href="${pageContext.request.contextPath}/director/refunds?status=Approved" class="${currentStatus == 'Approved' ? 'active' : ''}">Đã phê duyệt (${stats.approved})</a><a href="${pageContext.request.contextPath}/director/refunds?status=Rejected" class="${currentStatus == 'Rejected' ? 'active' : ''}">Đã từ chối (${stats.rejected})</a><a href="${pageContext.request.contextPath}/director/refunds?status=Completed" class="${currentStatus == 'Completed' ? 'active' : ''}">Đã hoàn tiền (${stats.completed})</a></div>
<div class="refund-card p-0 overflow-hidden"><div class="table-responsive"><table class="table refund-table mb-0"><thead><tr><th>Mã đơn</th><th>Bệnh nhân / Hóa đơn</th><th>Lịch hẹn</th><th>Số tiền hoàn</th><th>Trạng thái</th><th>Ngày tạo</th><th>Thao tác</th></tr></thead><tbody>
<c:forEach var="rf" items="${refunds}"><tr><td class="fw-semibold"><c:out value="${rf.formattedId}" /></td><td><strong><c:out value="${rf.patientName}" /></strong><div class="refund-muted small"><c:out value="${rf.patientPhone}" /> · <c:out value="${rf.formattedInvoiceId}" /></div></td><td><c:out value="${rf.formattedApptId}" /></td><td class="text-danger fw-semibold text-nowrap"><fmt:formatNumber value="${rf.amount}" /> đ</td><td><span class="badge ${rf.badgeClass}"><c:out value="${rf.statusVn}" /></span></td><td><c:out value="${rf.createdAt}" /></td><td class="refund-action"><a class="btn btn-sm btn-outline-primary" href="${pageContext.request.contextPath}/director/refunds/detail?id=${rf.id}"><i class="bi bi-eye me-1"></i>Xem chi tiết</a></td></tr></c:forEach>
<c:if test="${empty refunds}"><tr><td colspan="7" class="text-center text-muted p-5">Không tìm thấy yêu cầu hoàn tiền phù hợp.</td></tr></c:if>
</tbody></table></div></div></div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script></body></html>
