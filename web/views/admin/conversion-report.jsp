<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core" %>
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1"><title>Báo cáo tỷ lệ đến khám - VisionCare</title>
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet"><link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/admin-layout.css" rel="stylesheet"><link href="${pageContext.request.contextPath}/assets/css/admin-dashboard.css?v=20261031-8" rel="stylesheet"></head><body>
<jsp:include page="/views/admin/layout/admin-sidebar.jsp"><jsp:param name="activeNav" value="dashboard" /></jsp:include>
<div id="conversionData" hidden data-error="${not empty reportError}"><c:forEach items="${reportDays}" var="day"><span data-date="${day.date}" data-total="${day.total}" data-arrived="${day.arrived}" data-cancelled="${day.cancelled}" data-absent="${day.absent}" data-pending="${day.pending}" data-revenue="${day.revenue}"></span></c:forEach></div><main class="main-wrapper"><jsp:include page="/views/admin/layout/admin-header.jsp" /><div class="dashboard-page"><c:if test="${not empty reportError}"><div class="alert alert-danger" role="alert"><c:out value="${reportError}" /></div></c:if>
<div class="dashboard-top"><div><h1>Tổng quan phòng khám</h1><p>Theo dõi doanh thu, lịch hẹn và tỷ lệ bệnh nhân đến khám.</p></div></div>
    <nav class="clinic-report-nav" aria-label="Báo cáo phòng khám">
      <a href="${pageContext.request.contextPath}/admin/dashboard" class=""><i class="bi bi-wallet2"></i> Quản lý doanh thu</a>
      <a href="${pageContext.request.contextPath}/admin/conversion-report" class="active"><i class="bi bi-graph-up-arrow"></i> Báo cáo tỷ lệ đến khám</a>
    </nav>
<div class="dashboard-top"><div><h2 style="font-size:22px;font-weight:750">Báo cáo tỷ lệ đến khám</h2><p>Đánh giá mức độ thực hiện lịch hẹn và doanh thu từ các lượt khám.</p></div><button type="button" id="conversionExport" class="dashboard-action"><i class="bi bi-download"></i> Xuất báo cáo CSV</button></div>
<div class="conversion-note"><i class="bi bi-info-circle"></i> Tỷ lệ đến = lượt đã đến / tổng lịch hẹn × 100%. Doanh thu thực nhận của các lượt đã đến, tính theo ngày hẹn (bao gồm thu và hoàn tiền liên quan tại thời điểm xem).</div>
<form method="get" action="${pageContext.request.contextPath}/admin/conversion-report" id="conversionFilter" class="dashboard-filter">
      <div class="dashboard-tabs">
        <button name="period" value="today" class="${reportPeriod=='today'?'active':''}">Hôm nay</button>
        <button name="period" value="month" class="${reportPeriod=='month'?'active':''}">Tháng nay</button>
        <button name="period" value="year" class="${reportPeriod=='year'?'active':''}">Năm nay</button>
      </div>
      <span class="dashboard-date-field"><input type="text" id="conversionFrom" name="from" value="${reportFromDisplay}" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" aria-label="Từ ngày dd/MM/yyyy"><button type="button" class="dashboard-calendar-button" data-picker="conversionFromPicker" aria-label="Chọn ngày bắt đầu"><i class="bi bi-calendar3"></i></button><input type="date" id="conversionFromPicker" class="dashboard-native-picker" value="${reportFrom}" tabindex="-1" aria-hidden="true"></span>
      <span>đến</span>
      <span class="dashboard-date-field"><input type="text" id="conversionTo" name="to" value="${reportToDisplay}" pattern="[0-9]{2}/[0-9]{2}/[0-9]{4}" aria-label="Đến ngày dd/MM/yyyy"><button type="button" class="dashboard-calendar-button" data-picker="conversionToPicker" aria-label="Chọn ngày kết thúc"><i class="bi bi-calendar3"></i></button><input type="date" id="conversionToPicker" class="dashboard-native-picker" value="${reportTo}" tabindex="-1" aria-hidden="true"></span>
      <button name="period" value="custom" class="dashboard-apply">Áp dụng</button>
    </form>
<p id="conversionError" class="conversion-filter-error" role="alert" hidden></p>
<section class="dashboard-kpis conversion-kpis" aria-label="Chỉ số đến khám" aria-live="polite">
<article class="dashboard-card dashboard-kpi"><div class="dashboard-kpi-head"><span>Tổng lịch hẹn</span><i class="bi bi-calendar2-check"></i></div><p>Lịch hẹn có ngày khám trong kỳ</p><strong id="totalAppointments">—</strong><small>Bao gồm đã đến, hủy, vắng và chờ đến</small></article>
<article class="dashboard-card dashboard-kpi"><div class="dashboard-kpi-head"><span>Đã đến khám</span><i class="bi bi-person-check"></i></div><p>Lượt đã ghi nhận đến phòng khám</p><strong id="totalArrived">—</strong><small>Tính theo lượt hẹn, không theo bệnh nhân duy nhất</small></article>
<article class="dashboard-card dashboard-kpi"><div class="dashboard-kpi-head"><span>Tỷ lệ đến khám</span><i class="bi bi-graph-up-arrow"></i></div><p>Đã đến / Tổng lịch hẹn × 100%</p><strong id="attendanceRate">—</strong><small>Trong khoảng thời gian đã chọn</small></article>
<article class="dashboard-card dashboard-kpi"><div class="dashboard-kpi-head"><span>Doanh thu lượt khám</span><i class="bi bi-wallet2"></i></div><p>Tiền thu thành công trừ hoàn tiền</p><strong id="attendanceRevenue">—</strong><small id="averageRevenue">—</small></article>
</section>
<div class="dashboard-middle" style="margin-top:20px"><section class="dashboard-card dashboard-chart-panel"><div class="dashboard-panel-title"><div><h2>Xu hướng lịch hẹn &amp; đến khám</h2><p id="conversionRange"></p></div><i class="bi bi-bar-chart"></i></div><div class="dashboard-chart-legend"><span><i class="dashboard-legend-dot" style="background:#d8e8e3"></i>Lịch hẹn</span><span><i class="dashboard-legend-dot" style="background:#18a05e"></i>Đã đến</span></div><div id="conversionChart" class="conversion-trend" role="img" aria-label="Biểu đồ lịch hẹn và lượt đến khám"></div><p style="font-size:11px;color:#70827f;margin-top:16px">Các ngày được gộp thành tối đa 7 nhóm theo khoảng thời gian đã chọn.</p></section>
<section class="dashboard-card dashboard-source-panel"><div class="dashboard-panel-title"><div><h2>Phân bố trạng thái lịch hẹn</h2><p>Số lượt và tỷ trọng trên tổng lịch hẹn</p></div><i class="bi bi-pie-chart"></i></div><div id="conversionStatuses" class="conversion-funnel"></div></section></div>
<section class="dashboard-card conversion-table-panel"><div class="conversion-summary"><div><h2>Chi tiết theo ngày</h2><p>Tỷ lệ đến khám và doanh thu tương ứng trong kỳ</p></div><span id="conversionDayCount" class="dashboard-badge success"></span></div><div class="dashboard-table-wrap"><table class="dashboard-table"><thead><tr><th>Ngày khám</th><th>Lịch hẹn</th><th>Đã đến</th><th>Đã hủy</th><th>Vắng mặt</th><th>Chờ đến</th><th>Tỷ lệ đến</th><th>Doanh thu</th></tr></thead><tbody id="conversionRows"></tbody><tfoot id="conversionTotals"></tfoot></table></div><p class="conversion-empty" id="conversionEmpty" hidden>Không có dữ liệu  trong khoảng thời gian này.</p></section>
</div></main><script src="${pageContext.request.contextPath}/assets/js/admin-conversion-report.js?v=3" charset="UTF-8" defer></script></body></html>