<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<fmt:setLocale value="vi_VN" />
<!DOCTYPE html><html lang="vi"><head><title>Hóa đơn tổng #${invoice.id} - VisionCare</title><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
        <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css" rel="stylesheet">
        <jsp:include page="/views/admin/layout/admin-css.jsp" />
        <link href="${pageContext.request.contextPath}/assets/css/staff-invoices.css?v=20261105-inline" rel="stylesheet">
    </head><body class="invoice-fullscreen"><jsp:include page="/views/employee/layout/employee-sidebar.jsp"><jsp:param name="activeNav" value="invoices" /></jsp:include>
        <main class="main-wrapper"><jsp:include page="/views/admin/layout/admin-header.jsp" /><div class="invoice-workspace">

                <a class="invoice-back" href="${pageContext.request.contextPath}/staff/invoices"><i class="bi bi-arrow-left"></i> Quản lý hóa đơn &amp; thanh toán</a>
                <div class="invoice-heading"><div><div class="eyebrow">MASTER INVOICE · #APT-${invoice.appointmentId}</div><h2>Đối chiếu hóa đơn</h2><p><c:out value="${invoice.patientName}" /> · <c:out value="${invoice.phone}" /> · <c:out value="${invoice.date}" /></p></div><span class="invoice-pill invoice-status-${invoice.progressColor}"><c:out value="${invoice.paymentLabel}" /></span></div>
                <ol class="invoice-steps"><li class="active">1. Đối chiếu hóa đơn</li><li class="${checkout ? 'active' : ''}">2. Chọn phương thức &amp; thanh toán</li><li class="${invoice.finalized ? 'active' : ''}">3. Xuất hóa đơn</li></ol>
                <c:if test="${invoice.finalized}"><p class="text-muted">Đã chốt: <c:out value="${invoice.finalizedAt}" /> (giờ Việt Nam) · <c:out value="${invoice.cashierName}" /></p></c:if>
                <c:if test="${not empty sessionScope.invoiceSuccess}"><div class="alert alert-success"><c:out value="${sessionScope.invoiceSuccess}" /></div><c:remove var="invoiceSuccess" scope="session" /></c:if>
                <c:if test="${not empty sessionScope.invoiceError}"><div class="alert alert-danger"><c:out value="${sessionScope.invoiceError}" /></div><c:remove var="invoiceError" scope="session" /></c:if>
                <jsp:include page="/views/staff/refund-settlement.jsp" />
                <c:if test="${invoice.blocked}"><div class="alert alert-warning"><c:choose><c:when test="${refund.status == 'Approved'}">Yêu cầu hoàn tiền đã được director duyệt, đang chờ đối chiếu / chi trả. Tạm khóa thu thêm trên hóa đơn này.</c:when><c:when test="${refund.status == 'Pending'}">Yêu cầu hoàn tiền đang chờ director duyệt. Tạm khóa thu thêm trên hóa đơn này.</c:when><c:when test="${invoice.invoiceStatus == 'Refunded'}">Hóa đơn đã ghi nhận hoàn tiền. Không thu thêm trên hóa đơn này.</c:when><c:otherwise>Lịch hẹn hoặc hóa đơn đã hủy. Không thu thêm trên hóa đơn này.</c:otherwise></c:choose></div></c:if>
                <c:if test="${not invoice.clinicalComplete && not invoice.blocked && not invoice.declinedVisitReady}"><div class="alert alert-info">Có thể bỏ thủ thuật chưa thanh toán, chưa thực hiện nếu bệnh nhân từ chối. Chỉ chốt khi ca khám đã kết thúc và không còn chỉ định đang xử lý.</div></c:if>
                <c:if test="${invoice.declinedVisitReady && not invoice.blocked}"><div class="alert alert-info">Các thủ thuật còn chờ đã được bỏ. Xác nhận các khoản thu để kết thúc lượt xử lý này và chuyển sang chốt hóa đơn.</div></c:if>
                <c:if test="${invoice.unpriced && not invoice.finalized}"><div class="alert alert-warning">Có thuốc chưa có giá trong danh mục. Tổng các khoản đã có giá hiện là <strong><fmt:formatNumber value="${invoice.total}" /> đ</strong>; chưa thể xác định tổng cuối cùng, số tiền còn thiếu hoặc thu thừa cho đến khi đối chiếu giá / khoản khách không mua.</div></c:if>
                <c:if test="${invoice.unperformed && not invoice.finalized}"><div class="alert alert-warning">Có dịch vụ chưa thực hiện. Chờ hoàn tất, hoặc bỏ dịch vụ nếu bệnh nhân từ chối; không thu tiền như dịch vụ đã thực hiện.</div></c:if>
                <c:if test="${invoice.overpaid > 0 && not invoice.unpriced}"><div class="alert alert-warning">Khoản đã ghi nhận thu vượt tổng hiện tại <fmt:formatNumber value="${invoice.overpaid}" /> đ. Cần đối chiếu và xử lý hoàn tiền trước khi chốt.</div></c:if>
                <div class="invoice-detail-stack"><section class="invoice-card"><div class="invoice-section-title"><h5>Các khoản trên hóa đơn</h5><span>#INV-<fmt:formatNumber value="${invoice.id}" pattern="00000" groupingUsed="false" /></span></div><div class="table-responsive"><table class="table invoice-table"><thead><tr><th>Khoản thu</th><th class="text-end">SL</th><th class="text-end">Đơn giá</th><th class="text-end">Thành tiền</th><th>Thời gian ghi nhận</th><th>Phương thức</th><th></th></tr></thead><tbody>
                                    <c:forEach var="item" items="${invoice.items}" varStatus="itemRow"><tr class="${item.declined ? 'invoice-declined' : ''}"><td><strong><c:out value="${item.name}" /></strong><div class="small text-muted"><c:out value="${item.type}" /><c:if test="${item.refundedAmount > 0}"><div class="text-success">Đã hoàn ${item.refundedQuantity}: <fmt:formatNumber value="${item.refundedAmount}" /> đ</div></c:if><c:if test="${item.declined}"> · Khách từ chối / Không sử dụng</c:if><c:if test="${item.unperformed && not item.declined}"> · Chưa thực hiện</c:if></div></td><td class="text-end">${item.quantity}</td><td class="text-end text-nowrap"><c:choose><c:when test="${item.unpriced}">Chưa định giá</c:when><c:otherwise><fmt:formatNumber value="${item.unitPrice}" /> đ</c:otherwise></c:choose></td><td class="text-end text-nowrap"><c:choose><c:when test="${item.declined}">Không tính</c:when><c:when test="${item.unpriced}">—</c:when><c:otherwise><fmt:formatNumber value="${item.amount}" /> đ</c:otherwise></c:choose></td>
                                                    <c:if test="${itemRow.first}"><jsp:include page="/views/staff/invoice-payment-columns.jsp" /></c:if>
                                            <td><c:if test="${(invoice.canEdit || (invoice.canDeclineProcedure && item.procedure)) && item.removable && not item.declined}"><form action="${pageContext.request.contextPath}/staff/invoices/detail" method="post"><input type="hidden" name="csrfToken" value="${sessionScope.invoiceCsrf}"><input type="hidden" name="invoiceId" value="${invoice.id}"><input type="hidden" name="fingerprint" value="${fingerprint}"><input type="hidden" name="action" value="decline"><input type="hidden" name="itemKey" value="${item.key}"><button class="btn btn-sm btn-outline-danger" type="submit" title="Bỏ khoản bệnh nhân từ chối" onclick="return confirm('Bỏ khoản bệnh nhân từ chối khỏi hóa đơn? Dịch vụ chưa thực hiện sẽ được ghi nhận hủy.')"><i class="bi bi-trash"></i><span class="visually-hidden">Bỏ khoản bệnh nhân từ chối</span></button></form></c:if></td></tr></c:forEach>
                                    <c:if test="${empty invoice.items}"><tr><td colspan="4" class="text-muted">Chưa có khoản thu.</td><jsp:include page="/views/staff/invoice-payment-columns.jsp" /><td></td></tr></c:if>
                                    </tbody></table></div><div class="small text-muted px-4 pb-3">Thời gian và phương thức là các giao dịch của toàn hóa đơn, chưa phân bổ riêng cho từng dịch vụ. Chỉ giao dịch thành công được cộng vào tiền đã thu. Không thể bỏ phí khám, thủ thuật đã thực hiện hoặc khoản đã thanh toán riêng; ghi nhận không mua thuốc tại quầy không xóa đơn thuốc của bác sĩ.</div><div class="invoice-review-actions">
                                <c:choose>
                                        <c:when test="${invoice.finalized && not invoice.blocked}"><div class="alert alert-success mt-3 mb-0">Hoàn thành · Đã thanh toán đủ</div><a class="btn btn-teal w-100 mt-3" href="${pageContext.request.contextPath}/staff/invoices/export?id=${invoice.id}"><i class="bi bi-printer me-1"></i>Xem trước &amp; Xuất hóa đơn</a></c:when>
                                <c:when test="${not empty invoice.activePayment}"><div class="alert alert-info mt-3">Hóa đơn đang có giao dịch QR chờ xác nhận. Các khoản thu đang được khóa.</div><a class="btn btn-teal w-100" href="${pageContext.request.contextPath}/staff/invoices/checkout?id=${invoice.id}">Tiếp tục theo dõi thanh toán</a></c:when>
                                <c:when test="${invoice.canConfirmItems}"><form method="post" action="${pageContext.request.contextPath}/staff/invoices/detail" class="mt-3"><input type="hidden" name="csrfToken" value="${sessionScope.invoiceCsrf}"><input type="hidden" name="invoiceId" value="${invoice.id}"><input type="hidden" name="fingerprint" value="${fingerprint}"><input type="hidden" name="action" value="confirmReview"><p class="small text-muted">Kiểm tra các khoản thu và bỏ khoản bệnh nhân không mua trước khi chuyển sang thanh toán.</p><button class="btn btn-teal w-100" type="submit">Xác nhận</button></form></c:when>
                                </c:choose>
                        </div></section></div>
            </div></main><script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script></body></html>
