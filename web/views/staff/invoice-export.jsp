<%@page contentType="text/html" pageEncoding="UTF-8"%>
<%@taglib prefix="c" uri="http://java.sun.com/jsp/jstl/core"%>
<%@taglib prefix="fn" uri="http://java.sun.com/jsp/jstl/functions"%>
<%@taglib prefix="fmt" uri="http://java.sun.com/jsp/jstl/fmt"%>
<fmt:setLocale value="vi_VN" />
<!DOCTYPE html><html lang="vi"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Hóa đơn INV-${invoice.id}</title><link href="${pageContext.request.contextPath}/assets/css/staff-invoices.css?v=20261030-wide" rel="stylesheet"></head><body class="invoice-print-body">
<div class="invoice-print-toolbar"><a href="${pageContext.request.contextPath}/staff/invoices/detail?id=${invoice.id}">← Quay lại hóa đơn</a><button type="button" onclick="window.print()">In / Lưu PDF</button></div>
<article class="invoice-print-sheet"><header class="invoice-print-header"><div><h2>VisionCare</h2><p>HÓA ĐƠN THANH TOÁN</p></div><div>#INV-<fmt:formatNumber value="${invoice.id}" pattern="00000" groupingUsed="false" /><br>#APT-${invoice.appointmentId}<br><strong>Đã thanh toán đủ</strong></div></header>
<p><strong>Bệnh nhân:</strong> <c:out value="${invoice.patientName}" /><br><strong>Số điện thoại:</strong> <c:out value="${invoice.phone}" /><br><strong>Ngày chốt hóa đơn:</strong> <c:out value="${invoice.finalizedAt}" /> (GMT+7)<br><strong>Nhân viên thu ngân:</strong> <c:out value="${invoice.cashierName}" /><br><strong>Ngày khám:</strong> <c:out value="${invoice.date}" /></p>
<table class="invoice-print-table"><thead><tr><th>Khoản thu</th><th>SL</th><th>Đơn giá</th><th>Thành tiền</th></tr></thead><tbody><c:forEach var="item" items="${invoice.items}"><c:if test="${not item.declined}"><tr><td><c:out value="${item.name}" /></td><td>${item.quantity}</td><td><fmt:formatNumber value="${item.unitPrice}" /> đ</td><td><fmt:formatNumber value="${item.amount}" /> đ</td></tr><c:if test="${item.refundedAmount > 0}"><tr><td>Hoàn khoản chưa sử dụng: <c:out value="${item.name}" /></td><td>${item.refundedQuantity}</td><td><fmt:formatNumber value="${item.unitPrice}" /> đ</td><td>-<fmt:formatNumber value="${item.refundedAmount}" /> đ</td></tr></c:if></c:if></c:forEach></tbody></table>
<div class="invoice-print-total"><p>Tổng thanh toán: <strong><fmt:formatNumber value="${invoice.netTotal}" /> đ</strong></p><p>Đã ghi nhận thu: <strong><fmt:formatNumber value="${invoice.netPaid}" /> đ</strong></p><p>Còn lại: <strong>0 đ</strong></p></div>
<c:if test="${invoice.priorPaid > 0}"><p>Khoản thanh toán ghi nhận trước checkout: <strong><fmt:formatNumber value="${invoice.priorPaid}" /> đ</strong></p></c:if>
<h4>Giao dịch thanh toán</h4><c:forEach var="tx" items="${invoice.transactions}"><c:if test="${tx.status == 'Success'}"><p class="invoice-print-tx">#TX-${tx.id} · <c:out value="${tx.method}" /> · <fmt:formatNumber value="${tx.amount}" /> đ · <c:out value="${tx.date}" /></p></c:if></c:forEach><footer class="invoice-print-footer">Cảm ơn quý khách đã sử dụng dịch vụ tại VisionCare.<br>Vui lòng giữ hóa đơn để đối chiếu các khoản thanh toán.</footer></article></body></html>